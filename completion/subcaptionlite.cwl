#include:etoolbox

\begin{subfigure}{width}
\begin{subfigure}[pos]{width}
\end{subfigure}
\begin{subtable}{width}
\begin{subtable}[pos]{width}
\end{subtable}

\subcaption{text}
\subcaption*{text}
\subcaptionbox{text}{contents%text}
\subcaptionbox{text}[width]{contents%text}
\subref{label}#r
\subref*{label}#r