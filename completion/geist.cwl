#include:iftex
#include:xkeyval

#keyvals:\usepackage/geist#c
mainfont
scale=#%<factor%>,MatchLowercase
lining
tabular
proportional
bold
semibold
extrabold
black
regular
medium
#endkeyvals

# from T1 option of fontenc
\DH#n
\dh#n
\dj#n
\DJ#n
\guillemetleft#n
\guillemetright#n
\guillemotleft#*n
\guillemotright#*n
\guilsinglleft#n
\guilsinglright#n
\Hwithstroke#n
\hwithstroke#n
\k{arg}#n
\NG#n
\ng#n
\quotedblbase#n
\quotesinglbase#n
\textogonekcentered{arg}#n
\textquotedbl#n
\th#n
\TH#n