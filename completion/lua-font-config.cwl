# lua-font-config package
# Matthew Bertucci 2026/10/19 for v0.1

#include:svn-prov
#include:lua-unicode-math

\fontconfig{keyvals}

#keyvals:\fontconfig
rm=%<family name%>
rm={%<keyvals%>}
sf=%<family name%>
sf={%<keyvals%>}
tt=%<family name%>
tt={%<keyvals%>}
family=%<family name%>
family={%<keyvals%>}
math=%<family name%>
math={%<keyvals%>}
debug={%<keyvals%>}
#endkeyvals
