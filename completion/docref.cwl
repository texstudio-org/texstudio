# docref package
# Matthew Bertucci 2026/10/26 for v0.2

#include:iftex
#include:luatex

\docref{package}{label%plain}
\docref*{package}{label%plain}
\docnameref{package}{label%plain}
\docnameref*{package}{label%plain}
\docpageref{package}{label%plain}
\docpageref*{package}{label%plain}
\DocRefSource{package}{path%file}
\DocRefSource{package}{path%file}[doc path%file]