# chemidentifier package
# Matthew Bertucci 2026/09/04 for v2.0.0

\chemid*{key%plain}
\chemidfamily{parent}{options%keyvals}
\chemidhere{key%plain}
\chemidkey[factor]{motif}{key}
\chemidkey{motif}{key}
\chemidnote[factor]{motif}{text}
\chemidnote{motif}{text}
\chemidreset
\chemidscheme[scale]{path}
\chemidscheme{path}
\chemidsetup{options%keyvals}
\chemid{key%plain}

\chemidaddlanguage{language}{separator}#*
\chemidvalue#*

# not documented
\chemidanchoredfamily{arg}#S
\chemidanchored{arg}#S
\chemidfirstchild{arg1}{arg2}#S
\chemidgreekchar{arg}#S
\chemidpdftexfilenotfound{arg}#S
\chemidregisterfamily{arg1}{arg2}{arg3}{arg4}{arg5}{arg6}#S
\chemidregistervalue{arg1}{arg2}{arg3}#S
\chemidregister{arg1}{arg2}{arg3}{arg4}{arg5}{arg6}#S

# deprecated
\herechemid{key%plain}#S