# mayanumber package
# Matthew Bertucci 2026/09/11 for v1.0

#include:iftex
#include:xcolor
#include:fontspec

\mayanumber{number}
\mayanumber[options%keyvals]{number}
\mayanumber*{number}

#keyvals:\mayanumber
vertical
horizontal
colors
nocolor
scale=%<factor%>
align=#c,t,b
#endkeyvals

\mayanumerals#*

mayaTierra#B
mayaAgua#B
mayaVegetacion#B
mayaVida#B
mayaCielo#B
mayaSol#B
mayaUniverso#B