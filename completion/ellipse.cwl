#include:pict2e

\earc*[start angle,end angle]{x radius}{y radius}
\earc*{x radius}{y radius}
\earc[start angle,end angle]{x radius}{y radius}
\earc{x radius}{y radius}
\elliparc[initial]{center x}{center y}{x radius}{y radius}{start angle}{end angle}
\elliparc{center x}{center y}{x radius}{y radius}{start angle}{end angle}
\ellipse*{x radius}{y radius}
\ellipse{x radius}{y radius}

\pIIeearc*[start angle,end angle]{x radius}{y radius}#S
\pIIeearc*{x radius}{y radius}#S
\pIIeearc[start angle,end angle]{x radius}{y radius}#S
\pIIeearc{x radius}{y radius}#S
\pIIeelliparc[initial]{center x}{center y}{x radius}{y radius}{start angle}{end angle}#S
\pIIeelliparc{center x}{center y}{x radius}{y radius}{start angle}{end angle}#S
\pIIeellipse*{x radius}{y radius}#S
\pIIeellipse{x radius}{y radius}#S